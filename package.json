    "@neondatabase/serverless": "^1.2.1",
    "@stripe/stripe-js": "^9.5.0",
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^0.562.0",
    "next": "14.2.24",
