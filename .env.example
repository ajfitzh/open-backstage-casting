# ==============================================================================
# Open Backstage Casting — Environment Variables Template
# Copy this file to `.env.local` and fill in your credentials.
# ==============================================================================

# --- Baserow Database ---
NEXT_PUBLIC_BASEROW_URL=https://api.baserow.io
NEXT_PUBLIC_MASTER_REGISTRY_TABLE_ID=771
BASEROW_API_TOKEN=
NEXT_PUBLIC_BASEROW_TOKEN=
SANDBOX_BASEROW_TOKEN=
# Optional fallback tenant slug when running on bare localhost
DEFAULT_TENANT_SLUG=cytfred

# --- NextAuth & Google OAuth ---
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=Casting Team <casting@open-backstage.org>

# --- Payments (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Media Uploads (DigitalOcean Spaces / S3) ---
DO_SPACES_ENDPOINT=nyc3.digitaloceanspaces.com
DO_SPACES_REGION=us-east-1
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# --- Sandbox & Dev Flags ---
SANDBOX_PASSWORD=
ENABLE_DRY_RUN=false
